<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <TargetName>Flx.VisualStudio</TargetName>
    <AssemblyName>Flx.VisualStudio</AssemblyName>
    <RootNamespace>Flx.VisualStudio</RootNamespace>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
    <IntermediateOutputPath>$(BaseIntermediateOutputPath)$(Configuration)\$(TargetFramework)\</IntermediateOutputPath>
    <OutputPath>bin\$(Configuration)\$(TargetFramework)\</OutputPath>
    <OutDir>$(OutputPath)</OutDir>
    <TargetVsixContainerName>$(TargetName).vsix</TargetVsixContainerName>
    <TargetVsixContainer>$(OutDir)$(TargetVsixContainerName)</TargetVsixContainer>
    <GeneratePkgDefFile>false</GeneratePkgDefFile>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>false</IncludeDebugSymbolsInLocalVSIXDeployment>
    <MinimumVisualStudioVersion>18.0</MinimumVisualStudioVersion>
    <VsixType>v3</VsixType>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.5.40034" PrivateAssets="all" GeneratePathProperty="true" />
    <PackageReference Include="Microsoft.VisualStudio.LanguageServer.Client" Version="17.14.60" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="source.extension.vsixmanifest">
      <SubType>Designer</SubType>
    </None>

    <Content Include="Flx.pkgdef">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\grammar\flx-language-configuration.json">
      <Link>flx-language-configuration.json</Link>
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\grammar\flx.tmLanguage.json">
      <Link>Grammars\flx.tmLanguage.json</Link>
      <VSIXSubPath>Grammars</VSIXSubPath>
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Import Project="$(PkgMicrosoft_VSSDK_BuildTools)\tools\vssdk\Microsoft.VsSDK.targets" Condition="Exists('$(PkgMicrosoft_VSSDK_BuildTools)\tools\vssdk\Microsoft.VsSDK.targets')" />

  <PropertyGroup>
    <DetokenizeVsixManifestFileDependsOn>FlxRefreshVsixManifest;$(DetokenizeVsixManifestFileDependsOn)</DetokenizeVsixManifestFileDependsOn>
  </PropertyGroup>

  <Target Name="FlxRefreshVsixManifest">
    <Delete Files="$(IntermediateVsixManifest)" />
  </Target>

  <PropertyGroup>
    <FlxLastVsixVersionFile>$(BaseIntermediateOutputPath)last-vsix-version.txt</FlxLastVsixVersionFile>
  </PropertyGroup>

  <Target Name="FlxReadVsixManifestVersion">
    <XmlPeek
      XmlInputPath="source.extension.vsixmanifest"
      Query="/*[local-name()='PackageManifest']/*[local-name()='Metadata']/*[local-name()='Identity']/@Version">
      <Output TaskParameter="Result" PropertyName="FlxCurrentVsixVersion" />
    </XmlPeek>
  </Target>

  <Target Name="FlxEnsureVsixVersionWasBumped"
          BeforeTargets="CreateVsixContainer"
          DependsOnTargets="FlxReadVsixManifestVersion"
          Condition="'$(CreateVsixContainer)' == 'true'">
    <ReadLinesFromFile File="$(FlxLastVsixVersionFile)" Condition="Exists('$(FlxLastVsixVersionFile)')">
      <Output TaskParameter="Lines" PropertyName="FlxLastVsixVersion" />
    </ReadLinesFromFile>
    <Error
      Condition="'$(FlxLastVsixVersion)' != '' and '$(FlxLastVsixVersion)' == '$(FlxCurrentVsixVersion)'"
      Text="VSIX version $(FlxCurrentVsixVersion) was already packaged by the previous VSIX build. Increment Identity/@Version in source.extension.vsixmanifest before rebuilding so Visual Studio can install the update." />
  </Target>

  <Target Name="FlxRememberVsixVersion"
          AfterTargets="CreateVsixContainer"
          DependsOnTargets="FlxReadVsixManifestVersion"
          Condition="'$(CreateVsixContainer)' == 'true' and Exists('$(TargetVsixContainer)')">
    <WriteLinesToFile
      File="$(FlxLastVsixVersionFile)"
      Lines="$(FlxCurrentVsixVersion)"
      Overwrite="true" />
  </Target>

  <PropertyGroup>
    <GetVsixSourceItemsDependsOn>PublishFlxLanguageServerForVsix;$(GetVsixSourceItemsDependsOn)</GetVsixSourceItemsDependsOn>
  </PropertyGroup>

  <Target Name="PublishFlxLanguageServerForVsix">
    <Exec
      WorkingDirectory="$(MSBuildProjectDirectory)"
      Command="dotnet publish &quot;..\..\..\src\Flx.LanguageServer\Flx.LanguageServer.csproj&quot; -c Release -o &quot;server-bundle&quot;" />
    <ItemGroup>
      <Content Include="server-bundle\**\*"
               Exclude="server-bundle\**\*.pdb;server-bundle\**\*.xml">
        <Link>server-bundle\%(RecursiveDir)%(Filename)%(Extension)</Link>
        <IncludeInVSIX>true</IncludeInVSIX>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>
  </Target>

  <Target Name="FlxCreateVsixAfterBuild" AfterTargets="Build" DependsOnTargets="CreateVsixContainer" Condition="'$(CreateVsixContainer)' == 'true'" />
</Project>
